# =============================================================================
# CropShift Backend Environment Configuration Template
# Copy this file to .env for local development or configure these on Render.com
# =============================================================================

# Database connection URL (PostgreSQL with PostGIS extension enabled)
# For local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cropshift
# On Render: Use the Internal Database URL from your Render PostgreSQL instance

# Port (Render automatically sets $PORT; default is 8000 for local development)
PORT=8000

# Secret key for JWT signing (generate a strong random secret in production)
SECRET_KEY=replace-with-a-secure-random-32-byte-secret-key

# JWT Token Expiry in minutes (default: 10080 minutes = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed origins for CORS
# In production on Render: include your frontend Render URL
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://cropshift-web.onrender.com
