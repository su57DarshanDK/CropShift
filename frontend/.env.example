# =============================================================================
# CropShift Frontend Environment Configuration Template
# Copy this file to .env for local development or configure on Render.com
# =============================================================================

# Backend FastAPI base URL
# Local development: http://localhost:8000
# Production on Render: https://cropshift-api.onrender.com
VITE_API_URL=http://localhost:8000

# Set to false to use the live PostgreSQL database backend
VITE_USE_MOCKS=false
